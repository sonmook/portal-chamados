# Copiar para .env.homologacao na raiz. Não versionar valores reais.
STAGING_DOMAIN=homologacao.seu-dominio.example
DJANGO_SECRET_KEY=
# Fuso da instalação e calendário de SLA. Padrão: 24 horas de segunda a sexta.
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_SLA_INICIO=00:00
DJANGO_SLA_FIM=24:00
DJANGO_SLA_DIAS=0,1,2,3,4
# Datas YYYY-MM-DD separadas por vírgula; nenhuma é presumida automaticamente.
DJANGO_SLA_FERIADOS=
# Opcional: somente se houver conflito de rede no servidor.
HOMOLOGACAO_SUBNET=172.30.89.0/24
HOMOLOGACAO_PROXY_IP=172.30.89.254
# SMTP real: preencher no servidor/gerenciador de segredos, não no Git.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=
